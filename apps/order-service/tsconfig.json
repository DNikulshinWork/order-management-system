{
  "extends": "@repo/typescript-config/node.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsbuildinfo.json",
    "composite": true,
    "types": ["node", "pg"],
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
